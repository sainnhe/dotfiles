{
    "$schema": "https://opencode.ai/config.json",
    "update": "notify",
    "shell": "zsh",
    "username": "sainnhe",
    "model": "tencent-cloud/deepseek-flash",
    "snapshots": true,
    "formatter": true,
    "permissions": [
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "read",
            "resource": "*.env",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.key",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.pem",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.crt",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "grep",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "git remote *",
            "effect": "deny"
        },
        {
            "action": "subagent",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "opencode_list_mcp_resources",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "opencode_read_mcp_resource",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "execute",
            "resource": "*",
            "effect": "ask"
        }
    ],
    "default_agent": "build",
    "agents": {
        "chat": {
            "description": "General chat agent.",
            "mode": "primary",
            "system": "",
            "permissions": [
                {
                    "action": "*",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        }
    },
    "watcher": {
        "ignore": [
            "dist/**",
            "bazel-*/**",
            "target/**"
        ]
    },
    "websearch": {
        "provider": "random"
    },
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 80000
        },
        "buffer": 300000
    },
    "commands": {
        "review-diff": {
            "description": "Review the git diff",
            "template": "Review the git diff under current directory, including both staged and unstaged changes."
        }
    },
    "instructions": [
        "CONTRIBUTING.md"
    ],
    "plugins": [
        "cc-safety-net@latest"
    ],
    "providers": {
        "tencent-cloud": {
            "name": "Tencent Cloud",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://tokenhub.tencentmaas.cn/v1"
            },
            "env": [
                "TOKENHUB_API_KEY"
            ],
            "models": {
                "deepseek-flash": {
                    "modelID": "deepseek/deepseek-flash",
                    "name": "Deepseek Flash",
                    "family": "deepseek"
                },
                "glm-flash": {
                    "modelID": "glm-5.3-flash",
                    "name": "GLM Flash",
                    "family": "glm"
                },
                "glm": {
                    "modelID": "glm-5.3",
                    "name": "GLM",
                    "family": "glm"
                },
                "kimi": {
                    "modelID": "kimi-k3",
                    "name": "Kimi",
                    "family": "kimi"
                }
            }
        }
    }
}
