{
    "$schema": "https://opencode.ai/config.json",
    "update": "notify",
    "shell": "zsh",
    "username": "sainnhe",
    "model": "vertex-maas/deepseek-flash",
    "snapshots": true,
    "formatter": true,
    "permissions": [
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "read",
            "resource": "*.env",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.key",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.pem",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.crt",
            "effect": "deny"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "grep",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "git remote *",
            "effect": "deny"
        },
        {
            "action": "subagent",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "opencode_list_mcp_resources",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "opencode_read_mcp_resource",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "execute",
            "resource": "*",
            "effect": "ask"
        }
    ],
    "default_agent": "build",
    "agents": {
        "chat": {
            "description": "General chat agent.",
            "mode": "primary",
            "system": "",
            "permissions": [
                {
                    "action": "*",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        }
    },
    "watcher": {
        "ignore": [
            "dist/**",
            "bazel-*/**",
            "target/**"
        ]
    },
    "websearch": {
        "provider": "random"
    },
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 16384
        },
        "buffer": "15%"
    },
    "commands": {
        "review-diff": {
            "description": "Review the git diff",
            "template": "Review the git diff under current directory, including both staged and unstaged changes."
        }
    },
    "instructions": [
        "CONTRIBUTING.md"
    ],
    "plugins": [
        "cc-safety-net@latest"
    ],
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp"
            },
            "github": {
                "type": "remote",
                "url": "https://api.githubcopilot.com/mcp/",
                "oauth": false,
                "headers": {
                    "Authorization": "Bearer {env:OPENCODE_GITHUB_PAT}"
                }
            },
            "yahoo-finance": {
                "type": "local",
                "command": [
                    "uvx",
                    "--from",
                    "git+https://github.com/wshobson/maverick-mcp",
                    "maverick-mcp",
                    "--transport",
                    "stdio"
                ],
                "timeout": {
                    "startup": 120000
                }
            },
            "akshare": {
                "type": "local",
                "command": [
                    "uvx",
                    "--from",
                    "aktools",
                    "aktools-mcp"
                ],
                "timeout": {
                    "startup": 120000
                }
            }
        }
    },
    "providers": {
        "tencent-cloud": {
            "name": "Tencent Cloud",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://tokenhub.tencentmaas.cn/v1"
            },
            "env": [
                "TOKENHUB_API_KEY"
            ],
            "models": {
                "deepseek-flash": {
                    "modelID": "deepseek/deepseek-flash",
                    "name": "Deepseek Flash",
                    "family": "deepseek",
                    "limit": {
                        "context": 1048576
                    },
                    "body": {
                        "temperature": 1.0,
                        "top_p": 1.0
                    },
                    "cost": {
                        "input": 2,
                        "output": 8,
                        "cache": {
                            "read": 0.04
                        }
                    }
                },
                "kimi": {
                    "modelID": "kimi-k3.1-pro",
                    "name": "Kimi",
                    "family": "kimi",
                    "limit": {
                        "context": 1048576
                    },
                    "body": {
                        "temperature": 1.0,
                        "top_p": 0.95
                    },
                    "cost": {
                        "input": 13,
                        "output": 68,
                        "cache": {
                            "read": 1.3,
                            "write": 13
                        }
                    }
                },
                "hy": {
                    "modelID": "hy4",
                    "name": "Hy",
                    "family": "hy",
                    "limit": {
                        "context": 1048576
                    },
                    "body": {
                        "temperature": 0.9,
                        "top_p": 1.0
                    },
                    "cost": {
                        "input": 6,
                        "output": 18,
                        "cache": {
                            "read": 0.3
                        }
                    }
                }
            }
        },
        "vertex-maas": {
            "name": "Google Vertex AI (MaaS)",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://aiplatform.googleapis.com/v1/projects/{env:GOOGLE_CLOUD_PROJECT}/locations/global/endpoints/openapi"
            },
            "env": [
                "VERTEX_ACCESS_TOKEN"
            ],
            "models": {
                "deepseek-flash": {
                    "modelID": "deepseek-ai/deepseek-v4.1-flash-1017-maas",
                    "name": "Deepseek Flash",
                    "family": "deepseek",
                    "limit": {
                        "context": 1048576
                    },
                    "body": {
                        "temperature": 1.0,
                        "top_p": 1.0
                    },
                    "cost": {
                        "input": 2.1,
                        "output": 8.4,
                        "cache": {
                            "read": 0.21
                        }
                    }
                }
            }
        },
        "local": {
            "name": "Local",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://localhost:8081"
            },
            "models": {
                "qwen3.8-27b": {
                    "modelID": "Qwen/Qwen3.8-27B",
                    "name": "Qwen3.8 27B",
                    "family": "qwen",
                    "limit": {
                        "context": 131072
                    },
                    "body": {
                        "temperature": 1.0,
                        "top_p": 0.95,
                        "top_k": 20,
                        "min_p": 0.0,
                        "presence_penalty": 0.0,
                        "repetition_penalty": 1.0
                    }
                }
            }
        }
    }
}
