{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "show",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
